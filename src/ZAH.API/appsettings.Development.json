{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug"
    }
  },
  "MongoDB": {
    "ConnectionString": "mongodb://localhost:27017",
    "DatabaseName": "zah_ecommerce"
  },
  "JWT": {
    "Issuer": "ZAH.API",
    "Audience": "ZAH.Client",
    "AccessTokenExpirationMinutes": 30,
    "RefreshTokenExpirationDays": 30
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:4200",
      "http://localhost:5000",
      "https://localhost:5001"
    ]
  }
}
